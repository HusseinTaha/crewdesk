{
  "name": "crewdesk",
  "version": "0.2.0",
  "description": "One local dashboard for all your Claude Code sessions: answer questions, approve permissions and send follow-ups, routed back to the exact session.",
  "keywords": [
    "claude-code",
    "claude",
    "ai-agents",
    "dashboard",
    "hooks",
    "permissions",
    "multi-agent",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Hussein Taha",
  "homepage": "https://github.com/HusseinTaha/crewdesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HusseinTaha/crewdesk.git"
  },
  "bugs": {
    "url": "https://github.com/HusseinTaha/crewdesk/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "crewdesk": "bin/crewdesk.mjs",
    "crewdesk-hook": "bin/crewdesk-hook.mjs"
  },
  "files": [
    "bin/",
    "apps/server/dist/",
    "apps/web/dist/",
    "packages/hook/dist/",
    "docs/*.md",
    "!docs/CLAUDE-CONTROL-CENTER.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "ulid": "^3.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @crewdesk/server --filter @crewdesk/web dev",
    "dev:server": "pnpm --filter @crewdesk/server dev",
    "dev:web": "pnpm --filter @crewdesk/web dev",
    "build": "pnpm -r build",
    "start": "node bin/crewdesk.mjs start --foreground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.0"
  }
}
