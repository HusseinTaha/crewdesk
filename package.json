{
  "name": "claude-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard for managing multiple Claude Code sessions",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "claude-hub": "bin/claude-hub.mjs",
    "claude-hub-hook": "bin/claude-hub-hook.mjs"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cch/server --filter @cch/web dev",
    "dev:server": "pnpm --filter @cch/server dev",
    "dev:web": "pnpm --filter @cch/web dev",
    "build": "pnpm -r build",
    "start": "node bin/claude-hub.mjs start --foreground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.0"
  }
}
